{
  "projectId": "0831ab9a-f46e-4f5b-b7bf-805f8e18893a",
  "shape": "package",
  "pkg": "family-board",
  "globalName": "FamilyBoard",
  "buildCmd": "npx vite build --config .design-sync/vite.lib.config.mjs && node .design-sync/build-css.mjs",
  "cssEntry": "family-board.css",
  "srcDir": "src/components",
  "provider": {
    "component": "FamilyBoardRoot"
  },
  "docsDir": "../.design-sync/docs",
  "overrides": {
